   "source": [
    "# Celda 7\n",
    "\n",
    "# Listas para almacenar predicciones de cada tipo de modelo\n",
    "predictions_tree_depth = []\n",
    "predictions_tree_leaf = []\n",
    "predictions_logistic = []\n",
    "\n",
    "# 🔹 Entrenar 100 árboles con diferentes max_depth\n",
    "for i in range(100):\n",
    "    clf = DecisionTreeClassifier(max_depth=np.random.randint(1, 20), random_state=i)\n",
    "    clf.fit(X_train, y_train)\n",
    "    predictions_tree_depth.append(clf.predict(X_test))\n",
    "\n",
    "\n",
    "# 🔹 Entrenar 100 árboles con diferentes min_samples_leaf\n",
    "for i in range(100):\n",
    "    clf = DecisionTreeClassifier(min_samples_leaf=np.random.randint(1, 20), random_state=i+100)\n",
    "    clf.fit(X_train, y_train)\n",
    "    predictions_tree_leaf.append(clf.predict(X_test))\n",
    "\n",
    "# 🔹 Entrenar 100 regresiones logísticas\n",
    "for i in range(100):\n",
    "    log_model = LogisticRegression(random_state=i+200)\n",
    "    log_model.fit(X_train, y_train)\n",
    "    predictions_logistic.append(log_model.predict(X_test))\n",
    "\n",
    "# Función para obtener la votación mayoritaria de un conjunto de modelos\n",
    "def majority_voting(predictions):\n",
    "    pred_matrix = np.array(predictions)\n",
    "    majority_vote = np.round(pred_matrix.mean(axis=0))  # Votación mayoritaria por columna (observación)\n",
    "    return majority_vote\n",
    "\n",
    "# 🔹 Obtener predicciones finales de cada ensamble\n",
    "final_tree_depth_pred = majority_voting(predictions_tree_depth)\n",
    "final_tree_leaf_pred = majority_voting(predictions_tree_leaf)\n",
    "final_logistic_pred = majority_voting(predictions_logistic)\n",
    "\n",
    "# 🔹 Evaluación independiente de cada grupo de modelos\n",
    "tree_depth_acc = accuracy_score(y_test, final_tree_depth_pred)\n",
    "tree_depth_f1 = f1_score(y_test, final_tree_depth_pred)\n",
    "\n",
    "tree_leaf_acc = accuracy_score(y_test, final_tree_leaf_pred)\n",
    "tree_leaf_f1 = f1_score(y_test, final_tree_leaf_pred)\n",
    "\n",
    "logistic_acc = accuracy_score(y_test, final_logistic_pred)\n",
    "logistic_f1 = f1_score(y_test, final_logistic_pred)\n",
    "\n",
    "print(f\"Accuracy Árbol max_depth: {tree_depth_acc:.2f}, F1-score: {tree_depth_f1:.2f}\")\n",
    "print(f\"Accuracy Árbol min_samples_leaf: {tree_leaf_acc:.2f}, F1-score: {tree_leaf_f1:.2f}\")\n",
    "print(f\"Accuracy Regresión logística: {logistic_acc:.2f}, F1-score: {logistic_f1:.2f}\")\n",
    "\n",
    "\n",
    "# 🔹 Crear una matriz con todas las predicciones\n",
    "all_predictions = np.array(predictions_tree_depth + predictions_tree_leaf + predictions_logistic)\n",
    "\n",
    "# 🔹 Obtener la votación mayoritaria final\n",
    "final_ensemble_pred = np.round(all_predictions.mean(axis=0))\n",
    "\n",
    "# 🔹 Evaluación del ensamble completo\n",
    "ensemble_acc = accuracy_score(y_test, final_ensemble_pred)\n",
    "ensemble_f1 = f1_score(y_test, final_ensemble_pred)\n",
    "\n",
    "print(f\"Accuracy del ensamble total: {ensemble_acc:.2f}\")\n",
    "print(f\"F1-score del ensamble total: {ensemble_f1:.2f}\")"
   ]
