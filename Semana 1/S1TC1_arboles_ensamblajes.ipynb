   "source": [
    "# Celda 6\n",
    "\n",
    "# 🔹 División de datos en entrenamiento y prueba\n",
    "X_train, X_test, y_train, y_test = train_test_split(X, y, random_state=1, test_size=0.2)\n",
    "\n",
    "# 🔹 Optimización de max_depth en el árbol de decisión (basado en F1-score)\n",
    "max_depth_range = range(1, 20)\n",
    "F1_Scores = []\n",
    "\n",
    "for depth in max_depth_range:\n",
    "    clf = DecisionTreeClassifier(max_depth=depth, random_state=1)\n",
    "    f1 = cross_val_score(clf, X_train, y_train, cv=10, scoring='f1').mean()\n",
    "    F1_Scores.append(f1)\n",
    "\n",
    "# Encontrar la mejor profundidad según el mayor F1-score\n",
    "best_depth = max_depth_range[F1_Scores.index(max(F1_Scores))]\n",
    "\n",
    "# 🔹 Entrenamiento del árbol de decisión con la mejor profundidad\n",
    "tree_model = DecisionTreeClassifier(max_depth=best_depth, random_state=1)\n",
    "tree_model.fit(X_train, y_train)\n",
    "\n",
    "# Predicciones\n",
    "y_tree_pred = tree_model.predict(X_test)\n",
    "\n",
    "# Evaluación con F1-score y accuracy\n",
    "tree_f1 = f1_score(y_test, y_tree_pred)\n",
    "tree_acc = accuracy_score(y_test, y_tree_pred)\n",
    "\n",
    "# 🔹 Entrenamiento de regresión logística\n",
    "log_model = LogisticRegression(random_state=1)\n",
    "log_model.fit(X_train, y_train)\n",
    "\n",
    "# Predicciones\n",
    "y_log_pred = log_model.predict(X_test)\n",
    "\n",
    "# Evaluación con F1-score y accuracy\n",
    "log_f1 = f1_score(y_test, y_log_pred)\n",
    "log_acc = accuracy_score(y_test, y_log_pred)\n",
    "\n",
    "# 🔹 Comparación de desempeño\n",
    "print(f\"Mejor profundidad del árbol: {best_depth}\")\n",
    "print(f\"F1-score Árbol de decisión: {tree_f1:.2f}\")\n",
    "print(f\"Accuracy Árbol de decisión: {tree_acc:.2f}\")\n",
    "print(f\"F1-score Regresión logística: {log_f1:.2f}\")\n",
    "print(f\"Accuracy Regresión logística: {log_acc:.2f}\")\n",
    "\n",
    "if tree_f1 > log_f1:\n",
    "    print(\"El árbol de decisión tiene mejor desempeño en F1-score que la regresión logística.\")\n",
    "else:\n",
    "    print(\"La regresión logística tiene mejor desempeño en F1-score que el árbol de decisión.\")\n",
    "\n",
    "if tree_acc > log_acc:\n",
    "    print(\"El árbol de decisión tiene mejor precisión (accuracy) que la regresión logística.\")\n",
    "else:\n",
    "    print(\"La regresión logística tiene mejor precisión (accuracy) que el árbol de decisión.\")\n",
    "\n"
