   "source": [
    "# Celda 8\n",
    "# Función para calcular el peso basado en Accuracy\n",
    "def get_model_weight(predictions, y_test):\n",
    "    pred_matrix = np.array(predictions)\n",
    "    majority_vote = np.round(pred_matrix.mean(axis=0))\n",
    "    return accuracy_score(y_test, majority_vote)  \n",
    "\n",
    "# Obtener pesos para cada grupo de modelos\n",
    "weight_tree_depth = get_model_weight(predictions_tree_depth, y_test)\n",
    "weight_tree_leaf = get_model_weight(predictions_tree_leaf, y_test)\n",
    "weight_logistic = get_model_weight(predictions_logistic, y_test)\n",
    "\n",
    "# Normalizar pesos para que sumen 1\n",
    "total_weight = weight_tree_depth + weight_tree_leaf + weight_logistic\n",
    "weight_tree_depth /= total_weight\n",
    "weight_tree_leaf /= total_weight\n",
    "weight_logistic /= total_weight\n",
    "\n",
    "print(f\"Pesos asignados -> Árbol max_depth: {weight_tree_depth:.2f}, Árbol min_samples_leaf: {weight_tree_leaf:.2f}, Regresión logística: {weight_logistic:.2f}\")\n",
    "\n",
    "# 🔹 Convertir predicciones en una matriz\n",
    "all_predictions = np.array(predictions_tree_depth + predictions_tree_leaf + predictions_logistic)\n",
    "\n",
    "# 🔹 Aplicar pesos a cada grupo de modelos\n",
    "weighted_prediction = (\n",
    "    weight_tree_depth * np.array(predictions_tree_depth).mean(axis=0) +\n",
    "    weight_tree_leaf * np.array(predictions_tree_leaf).mean(axis=0) +\n",
    "    weight_logistic * np.array(predictions_logistic).mean(axis=0)\n",
    ")\n",
    "\n",
    "# 🔹 Convertir la predicción ponderada en 0 o 1\n",
    "final_weighted_pred = np.round(weighted_prediction)\n",
    "\n",
    "# 🔹 Evaluar el ensamble completo\n",
    "ensemble_acc = accuracy_score(y_test, final_weighted_pred)\n",
    "ensemble_f1 = f1_score(y_test, final_weighted_pred)\n",
    "\n",
    "print(f\"Accuracy del ensamble ponderado: {ensemble_acc:.2f}\")\n",
    "print(f\"F1-score del ensamble ponderado: {ensemble_f1:.2f}\")\n"
   ]
